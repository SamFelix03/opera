# Cleanverse UAT
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=

# Monad Testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_WS_URL=wss://testnet-rpc.monad.xyz

# Deployer (Foundry / cast)
DEPLOYER_PRIVATE_KEY=0x
DEPLOYER_ADDRESS=0x

# Score oracle writer (separate EOA — not the deployer)
SCORE_WRITER_PRIVATE_KEY=0x
SCORE_WRITER_ADDRESS=0x

# Public HTTPS base for A-Token webhooks (Cloudflare Tunnel / ngrok)
WEBHOOK_BASE_URL=

# Backend
PORT=8787
SESSION_SECRET=
DATABASE_PATH=./data/opera-audit.sqlite

# Demo orchestration (PRD §8)
# DEMO_MOCK=1  # skip Cleanverse/chain; unit-test / offline step machine
# WORKERS_ENABLED=1
# SCORE_OPERATORS=0x...,0x...
# SCORE_INTERVAL_MS=15000
# DEMO_OWNER_ADDRESS=  # notification target for score-worker auto-list
